{
  "name": "argon2",
  "version": "0.45.1",
  "description": "An Argon2 library for Node",
  "keywords": [
    "argon2",
    "crypto",
    "encryption",
    "hashing",
    "password"
  ],
  "homepage": "https://github.com/ranisalt/node-argon2#readme",
  "bugs": {
    "url": "https://github.com/ranisalt/node-argon2/issues"
  },
  "license": "MIT",
  "author": "Ranieri Althoff <ranisalt+argon2@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranisalt/node-argon2.git"
  },
  "files": [
    "argon2.cpp",
    "argon2.d.cts",
    "argon2.d.cts.map",
    "argon2/CHANGELOG.md",
    "argon2/LICENSE",
    "argon2/include/",
    "argon2/src/argon2.c",
    "argon2/src/blake2/",
    "argon2/src/core.c",
    "argon2/src/core.h",
    "argon2/src/encoding.c",
    "argon2/src/encoding.h",
    "argon2/src/opt.c",
    "argon2/src/ref.c",
    "argon2/src/thread.c",
    "argon2/src/thread.h",
    "marmotta.config.js",
    "prebuilds/**/*.node",
    "scripts/"
  ],
  "type": "commonjs",
  "main": "argon2.cjs",
  "types": "argon2.d.cts",
  "scripts": {
    "build": "node scripts/build.cjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "install": "node scripts/install.cjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "tsc",
    "test": "node --test test.cjs"
  },
  "dependencies": {
    "@phc/format": "^1.0.0",
    "node-addon-api": "^8.9.0",
    "marmotta": "^0.5.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.5",
    "@types/node": "24.13.3",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=16.17.0"
  },
  "packageManager": "npm@12.0.1",
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/node-argon2"
  }
}
